# SmartWaste Client Environment Configuration

# API Base URL
# For local development with Vite proxy: /api
# For Vercel deployment: https://your-railway-backend.railway.app
# For production: https://api.smartwaste.ke
VITE_API_BASE_URL=/api

# Vite Proxy Target (for local development only)
# Points to the backend server running locally
# This is NOT used in production or Vercel deployment
VITE_PROXY_TARGET=http://localhost:4000

# Environment
# development, staging, or production
VITE_ENV=development
