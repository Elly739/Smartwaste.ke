# SmartWaste Server Environment Configuration

# Server Port
PORT=4000

# Database Configuration
# Choose one of the following:

# Option 1: PostgreSQL (Neon) - Production Recommended
# Uncomment and set your Neon connection string
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Option 2: SQLite (Development/Testing)
# Set USE_SQLITE=true to force SQLite usage (ignores DATABASE_URL)
# USE_SQLITE=true
# DATABASE_PATH=./data/smartwaste.sqlite (relative to project root)

# PostgreSQL Connection Pool Settings (only used with DATABASE_URL)
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=2000

# Admin Credentials (for initial seeding)
# WARNING: Change these in production!
ADMIN_EMAIL=iamellyokello@gmail.com
ADMIN_PASSWORD=AGXR4X45
ADMIN_NAME=Elly Admin

# CORS Configuration
# Frontend URL that can access this API
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
NODE_ENV=development
